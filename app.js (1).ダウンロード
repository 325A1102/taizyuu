function submitReport(e){e.preventDefault();if(role!=='student')return;const form=$('#report-form');if(!form.reportValidity())return;const d=formData();for(const k of ['company','job','flow','q1','pr','advice']){if(!d[k]?.trim()){toast('必須項目に内容を入力してください。');$(`[name="${k}"]`).focus();return;}}if(!/^\d{4}-\d{2}$/.test(d.offer)||!['A学科','B学科','C学科'].includes(d.dept)){toast('学科と内定時期を確認してください。');return;}const fields=Object.fromEntries(Object.entries(d).map(([k,v])=>[k,v.trim()]));const now=new Date().toISOString();const stages=[['一次選考',fields.q1],['二次選考',fields.q2],['最終選考',fields.q3]].filter(([,content])=>content).map(([stage,content])=>({id:crypto.randomUUID(),stage,content,createdAt:now}));let next;if(editing){const old=reports.find(r=>r.id===editing&&r.author===student&&r.status==='returned');if(!old){toast('この報告書は編集できません。');return;}next=reports.map(r=>r.id===editing?{...r,...fields,stages,status:'pending',reason:'',updated:now}:r);}else next=[...reports,{...fields,stages,id:crypto.randomUUID(),author:student,status:'pending',created:now,color:'blue',mark:fields.company.slice(0,1)}];if(write(KEYS.reports,next)){reports=next;editing=null;write(KEYS.draft,{});render();toast('報告書を提出しました。教員の承認をお待ちください。');}}
function addStageDialog(id){const r=reports.find(x=>x.id===id&&x.author===student);if(role!=='student'||!r||!['approved','pending'].includes(r.status))return;const done=(r.stages||[]).map(s=>s.stage);const choices=['一次選考','二次選考','最終選考','その他'].filter(x=>!done.includes(x));if(!choices.length){toast('追加できる選考段階がありません。');return;}openModal('選考内容を追加',`<p class="help">${esc(r.company)}の報告書に選考記録を追加します。追加内容は教員の確認後に公開されます。</p><form id="stage-form" data-id="${esc(id)}"><div class="field"><label for="stage-name">選考段階</label><select id="stage-name" required>${choices.map(x=>`<option>${esc(x)}</option>`).join('')}</select></div><div class="field"><label for="stage-content">質問・選考内容</label><textarea id="stage-content" required maxlength="4000" placeholder="聞かれた質問、選考の様子、準備したことなど"></textarea></div><div class="form-actions"><button class="btn primary" type="submit">追加して提出</button><button class="btn" type="button" data-close>キャンセル</button></div></form>`);}
function submitStage(e){e.preventDefault();if(role!=='student')return;const id=e.target.dataset.id,r=reports.find(x=>x.id===id&&x.author===student);if(!r)return;const stage=$('#stage-name').value,content=$('#stage-content').value.trim();if(!content)return;const now=new Date().toISOString(),next=reports.map(x=>x.id===id?{...x,stages:[...(x.stages||legacyStages(x)),{id:crypto.randomUUID(),stage,content,createdAt:now}],status:'pending',reason:'',updated:now}:x);if(write(KEYS.reports,next)){reports=next;$('#modal').close();render();toast('選考内容を追加しました。教員の承認後に公開されます。');}}
function legacyStages(r){return [['一次選考',r.q1],['二次選考',r.q2],['最終選考',r.q3]].filter(([,content])=>content&&content!=='二次面接なし').map(([stage,content])=>({id:stage,stage,content,createdAt:r.created}));}
function adminPage(){return `${heading('経験を確認して、次の世代へ。','学生から届いた報告書を確認し、安心して読める情報を届けましょう。','TEACHER WORKSPACE')}${metrics()}<div class="workflow"><strong>${icon('file-pen')} 学生が提出</strong>${icon('chevron-right')} 教員が内容を確認 ${icon('chevron-right')} <strong>${icon('circle-check')} 承認・公開</strong></div><div class="result-heading"><h2>承認待ちの報告書<span class="count">${pending().length} 件</span></h2><span class="filter-summary">公開前に内容をご確認ください</span></div><div class="admin-list">${pending().length?pending().map(r=>`<article class="admin-card"><div class="admin-company">${companyLogo(r)}<div><h3>${esc(r.company)} ${statusBadge(r)}</h3><p>${esc(r.dept)} · ${esc(r.job)} · ${esc(r.author)}</p><p>提出日 ${stamp(r.created)}</p></div></div><div class="actions"><button class="btn small primary" data-detail="${esc(r.id)}">内容を確認 ${icon('arrow-right')}</button><button class="btn small" data-return="${esc(r.id)}">差戻し</button><button class="btn small danger" data-delete="${esc(r.id)}">削除</button></div></article>`).join(''):`<div class="empty">${icon('clipboard-check')}<h3>すべて確認済みです</h3><p>新しい報告書が届くと、ここに表示されます。</p></div>`}</div><section class="panel my-reports"><h2 class="section-title">${icon('clock-rotate-left')} 差戻し中の報告書</h2>${reports.filter(r=>r.status==='returned').map(r=>`<div class="row"><div><h3>${esc(r.company)} ${statusBadge(r)}</h3><p>${esc(r.author)}</p><p class="change-reason">${esc(r.reason||'修正待ち')}</p></div><button class="btn small" data-detail="${esc(r.id)}">内容を見る</button></div>`).join('')||'<p class="help">現在、差戻し中の報告書はありません。</p>'}</section>`;}
function dashboardPage(){const data=approved();const dep=['A学科','B学科','C学科'].map(name=>({name,count:data.filter(r=>r.dept===name).length}));const companyCounts={};data.forEach(r=>companyCounts[r.company]=(companyCounts[r.company]||0)+1);const companies=Object.entries(companyCounts).sort((a,b)=>b[1]-a[1]||a[0].localeCompare(b[0],'ja')).slice(0,5);const words=['志望動機','チーム','学生時代','作品','強み','課題','将来','アルバイト'].map(name=>({name,count:data.filter(r=>[r.q1,r.q2,r.q3].join(' ').includes(name)).length})).filter(x=>x.count).sort((a,b)=>b.count-a.count);const total=reports.length;return `${heading('データから、就職支援をもっとよく。','承認済みの報告書をもとに、学科の傾向と面接のポイントを可視化します。','CAREER INSIGHTS')}${metrics()}<div class="dashboard-grid"><section class="panel"><h2 class="section-title">${icon('chart-simple')} 学科別の報告書数</h2><p class="help">承認済み報告書 ${data.length}件を集計</p>${dep.map((x,i)=>barRow(x.name,x.count,Math.max(...dep.map(y=>y.count),1),i===1)).join('')}</section><section class="panel"><h2 class="section-title">${icon('building')} 報告の多い企業 TOP 5</h2><p class="help">報告件数を指標とした企業ランキング</p>${companies.map(([name,n])=>barRow(name,n,Math.max(...companies.map(c=>c[1]),1))).join('')||'<div class="empty">承認済み報告書がありません</div>'}</section><section class="panel"><h2 class="section-title">${icon('comments')} 面接でよく出るキーワード</h2><p class="help">各語を含む報告書数（一次・二次・最終面接の質問から集計）</p><div class="keyword-cloud">${words.map(x=>`<span class="keyword">${esc(x.name)}<small>${x.count}件</small></span>`).join('')||'<p class="help">集計対象がありません。</p>'}</div></section><section class="panel"><h2 class="section-title">${icon('clipboard-check')} 承認状況</h2><p class="help">全 ${total} 件の報告書</p>${['approved','pending','returned'].map((s,i)=>barRow(['承認済み','承認待ち','差戻し'][i],reports.filter(r=>r.status===s).length,total||1,i===0)).join('')}</section></div><p class="help" style="margin-top:18px">この統計は現在のブラウザにある報告書が対象です。学生全体の就職率や企業人気の調査結果ではありません。</p>`;}
