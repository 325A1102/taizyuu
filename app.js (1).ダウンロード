function renderChat(){const log=$('#chat-messages');if(!log)return;const welcome=settings.key?'こんにちは、AI就活アドバイザーです。あなたの経験を大切にしながら、次の一歩を一緒に考えます。今日はどんなことを相談したいですか？':'こんにちは！まずはデモで相談の流れを体験できます。APIキーを設定すると実際のAIと相談できます。\n下のボタンから、気になるテーマを選んでみましょう。';const messages=[{role:'model',text:welcome,source:'guide'},...chat];log.innerHTML=messages.map(m=>`<div class="message ${m.role==='user'?'user':''}"><div class="message-avatar">${m.role==='user'?'YOU':icon('wand-magic-sparkles')}</div><div class="message-body"><span class="message-source">${m.role==='user'?'あなた':m.source==='api'?'Gemini AI':m.source==='error'?'接続エラー':m.source==='guide'?'ご案内':'デモ応答 · 定型文'}</span>${esc(m.text)}</div></div>`).join('')+(busy?`<div class="message"><div class="message-avatar">${icon('wand-magic-sparkles')}</div><div class="message-body">考えを整理しています…</div></div>`:'');log.scrollTop=log.scrollHeight;const input=$('#chat-text');if(input)input.disabled=busy;const send=$('#chat-form button');if(send)send.disabled=busy;}
function demoResponse(t){if(/志望|添削|自己PR/.test(t))return '【デモ応答】文章を磨くときは、次の3点を確認してみましょう。\n\n1. なぜその企業なのか：事業や仕事の特徴と、自分の経験をつなげる。\n2. どんな強みがあるか：具体的な行動と結果を一つ入れる。\n3. 入社後にどう貢献したいか：応募職種に合わせて書く。\n\n「私は〇〇を経験し、△△の力を身につけました。貴社の□□に共感し、この力を活かして◇◇に貢献したいです。」という流れを参考にしてください。\n\nこのデモは入力した文章そのものの添削は行いません。APIキー設定後、文章を送るとAIから具体的なフィードバックを受けられます。';if(/面接/.test(t))return '【デモ応答】模擬面接の最初の質問です。\n\n「学生時代に最も力を入れたことを、具体的な経験とともに教えてください。」\n\n状況 → 課題 → 自分の行動 → 結果・学びの順で、1分程度にまとめる練習をしてみましょう。\n\n回答に合わせたフィードバックを受けるには、APIキーを設定して実際のAI相談をご利用ください。';if(/分析|強み/.test(t))return '【デモ応答】強みは、特別な実績だけでなく普段の行動からも見つかります。\n\n最近、周りの人から感謝された出来事を一つ思い出してみてください。\n・どんな場面でしたか？\n・あなたは何をしましたか？\n・そのとき、何を大切にしましたか？\n\n出来事をメモすると、強みの根拠が見つかりやすくなります。APIキー設定後は、あなたの回答に合わせて質問を深められます。';return '【デモ応答】就活の悩みは、小さく分けると次の行動が見えてきます。\n\n今の悩みを「企業選び」「応募書類」「面接準備」のどれかに分けて、今日できることを一つ決めてみましょう。\n\nAPIキーを設定すると、あなたの相談内容に合わせて実際のAIが具体的にアドバイスします。';}
const systemPrompt='あなたは日本の専門学校の親身な就職指導教員です。日本語で、学生の経験を尊重し、具体的で実行できる就職活動の支援を行ってください。最初に良い点を示し、改善点と次の行動を短く説明してください。添削では原文にない経験や数値を捏造せず、不足情報を質問し、改善例を明確に区別してください。自己分析と模擬面接では質問を一問ずつ行い、回答を受けてからフィードバックしてください。企業の最新事情を確認済みのように断定しないでください。内定を保証しないでください。センシティブな個人情報を求めず、必要に応じ学校の就職課に相談するよう促してください。読みやすい平文と箇条書きで回答してください。';
async function sendChat(text){text=text.trim();if(!text||busy)return;if(text.length>6000){toast('相談内容は6000文字以内で入力してください。');return;}const mode=settings.key?'api':'demo';const epoch=chatEpoch;const userMessage={role:'user',text,source:mode};chat.push(userMessage);chat=chat.slice(-40);write(KEYS.chat,chat);busy=true;renderChat();if($('#chat-text'))$('#chat-text').value='';try{let answer;if(mode==='demo'){answer=demoResponse(text);}else{const model=settings.model||'gemini-3.5-flash-lite';controller=new AbortController();const timer=setTimeout(()=>controller?.abort(),60000);try{const contents=chat.filter(m=>m.source==='api').slice(-16).map(m=>({role:m.role,parts:[{text:m.text}]}));while(contents[0]?.role==='model')contents.shift();const res=await fetch(`https://generativelanguage.googleapis.com/v1beta/models/${encodeURIComponent(model)}:generateContent`,{method:'POST',headers:{'Content-Type':'application/json','x-goog-api-key':settings.key},body:JSON.stringify({systemInstruction:{parts:[{text:systemPrompt}]},contents,generationConfig:{temperature:0.7,maxOutputTokens:4096}}),signal:controller.signal});if(!res.ok)throw new Error(({400:'入力形式、APIキー、モデル設定を確認してください。',401:'APIキーが正しくありません。設定を確認してください。',403:'このAPIキーでは利用できません。権限やキーの制限を確認してください。',404:'指定したモデルが利用できません。設定画面でモデル名を変更してください。',429:'利用上限に達しました。Google側の使用量・上限を確認し、時間をおいて再送してください。'})[res.status]||`サービスが応答できませんでした（HTTP ${res.status}）。時間をおいて再送してください。`);const data=await res.json();answer=data.candidates?.[0]?.content?.parts?.filter(p=>!p.thought&&typeof p.text==='string').map(p=>p.text).join('\n');if(!answer)throw new Error(data.promptFeedback?.blockReason?'この内容への回答は制限されました。相談内容を言い換えてください。':'AIから文章を取得できませんでした。相談内容を確認して再送してください。');if(data.candidates?.[0]?.finishReason==='MAX_TOKENS')answer+='\n\n（応答の長さの上限に達しました。続きを希望する場合は追加で質問してください。）';}finally{clearTimeout(timer);controller=null;}}if(epoch===chatEpoch){chat.push({role:'model',text:answer,source:mode});write(KEYS.chat,chat);}}catch(error){if(epoch===chatEpoch){userMessage.source='failed';chat.push({role:'model',text:error.name==='AbortError'?'応答を待つ時間の上限に達しました。時間をおいて再送してください。':error instanceof TypeError?'通信できませんでした。ネットワーク接続やブラウザの通信制限を確認してください。':error.message,source:'error'});write(KEYS.chat,chat);}}finally{busy=false;renderChat();if(view==='ai')$('#chat-text')?.focus();}}
function openModal(title,html){$('#modal-title').textContent=title;$('#modal-body').innerHTML=`<div class="dialog-body">${html}</div>`;if(!$('#modal').open)$('#modal').showModal();}
