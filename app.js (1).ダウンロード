function updateReport(id,status,reason=''){if(role!=='teacher')return false;const found=reports.find(r=>r.id===id);if(!found||found.status!=='pending')return false;const next=reports.map(r=>r.id===id?{...r,status,reason,reviewer:'就職課 サトウ先生',reviewed:new Date().toISOString()}:r);if(!write(KEYS.reports,next))return false;reports=next;$('#modal').close();render();toast(status==='approved'?'承認しました。検索画面に公開されました。':'差戻しました。学生は修正して再提出できます。');return true;}
function returnDialog(id){if(role!=='teacher'||!pending().some(r=>r.id===id))return;openModal('報告書を差戻す',`<p class="help" style="margin-bottom:18px">修正してほしい点を具体的に伝えてください。</p><form id="return-form" data-id="${esc(id)}"><div class="field"><label for="return-reason">差戻し理由<span class="required">必須</span></label><textarea id="return-reason" required maxlength="1000" placeholder="例：選考フローに最終面接の内容を追記してください。"></textarea></div><div class="form-actions"><button class="btn primary" type="submit">差戻す</button><button type="button" class="btn" data-close>キャンセル</button></div></form>`);}
function deleteDialog(id){if(role!=='teacher'||!pending().some(r=>r.id===id))return;const r=reports.find(r=>r.id===id);openModal('報告書を削除する',`<p>「${esc(r.company)}」の報告書を削除します。</p><p class="help">この操作は取り消せません。修正を求める場合は差戻しをご利用ください。</p><div class="form-actions"><button class="btn danger" data-confirm-delete="${esc(id)}">削除する</button><button class="btn" data-close>キャンセル</button></div>`);}
function keyDialog(){openModal('Gemini API 設定',`<p class="help" style="margin-bottom:18px">自分のAPIキーを設定すると、実際のAIに相談できます。</p><form id="key-form" class="key-form"><div class="field"><label for="api-key">Gemini APIキー</label><input type="password" id="api-key" autocomplete="off" spellcheck="false" placeholder="APIキーを入力" value="${esc(settings.key||'')}" maxlength="256"><button type="button" class="text-btn" id="toggle-key" style="justify-self:start">キーを表示</button></div><div class="field"><label for="api-model">モデル名</label><input id="api-model" value="${esc(settings.model||'gemini-3.5-flash-lite')}" required pattern="[A-Za-z0-9._-]+" maxlength="100"><p class="help">Gemini 1.5 Flashは提供終了。利用できるモデル名を指定してください。</p></div><div class="key-notice">キーはこのブラウザのLocalStorageに保存します。共有端末では使用後に削除してください。相談内容とキーは、送信時にGoogleのAPIへ直接送られます。Geminiの料金・上限はGoogle側の設定に従い、ChatGPTの契約とは別です。<br><a href="https://aistudio.google.com/apikey" target="_blank" rel="noopener noreferrer" style="color:#337ac7">Google AI Studioでキーを確認 ↗</a> · <a href="https://ai.google.dev/gemini-api/docs/pricing" target="_blank" rel="noopener noreferrer" style="color:#337ac7">料金を確認 ↗</a></div><div class="actions"><button type="submit" class="btn primary">設定を保存</button><button type="button" class="btn danger" id="remove-key">キーを削除・デモに戻る</button></div></form>`);}
function clearChatDialog(){openModal('相談履歴をクリア',`<p>このブラウザに保存した相談履歴を削除します。</p><div class="form-actions"><button class="btn primary" id="confirm-clear-chat">クリアする</button><button class="btn" data-close>キャンセル</button></div>`);}
document.addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;if(b.dataset.view)return navigate(b.dataset.view);if(b.dataset.key!==undefined||b.id==='key-button')return keyDialog();if(b.id==='modal-close'||b.hasAttribute('data-close'))return $('#modal').close();if(b.dataset.detail)return detail(b.dataset.detail);if(b.dataset.addStage)return addStageDialog(b.dataset.addStage);if(b.dataset.bookmark){const id=b.dataset.bookmark;const next=bookmarks.includes(id)?bookmarks.filter(x=>x!==id):[...bookmarks,id];if(write(KEYS.bookmarks,next)){bookmarks=next;renderResults();const m=$('.metrics');if(m)m.outerHTML=metrics();toast(bookmarks.includes(id)?'報告書を保存しました。':'保存から外しました。');}return;}if(b.id==='reset-filters'){filters={q:'',dept:'',job:'',offer:'',saved:false,sort:'newest'};return render();}if(b.dataset.dept){filters.dept=filters.dept===b.dataset.dept?'':b.dataset.dept;return render();}if(b.id==='saved-filter'){filters.saved=!filters.saved;return render();}if(b.id==='save-draft')return saveDraft();if(b.id==='cancel-edit'){editing=null;write(KEYS.draft,{});return render();}if(b.dataset.edit&&role==='student'){editing=b.dataset.edit;view='submit';render();return window.scrollTo({top:0,behavior:'smooth'});}if(b.dataset.approve)return updateReport(b.dataset.approve,'approved');if(b.dataset.return)return returnDialog(b.dataset.return);if(b.dataset.delete)return deleteDialog(b.dataset.delete);if(b.dataset.confirmDelete&&role==='teacher'){const id=b.dataset.confirmDelete;if(!pending().some(r=>r.id===id))return;const next=reports.filter(r=>r.id!==id);if(write(KEYS.reports,next)){reports=next;$('#modal').close();render();toast('報告書を削除しました。');}return;}if(b.dataset.quick)return sendChat(quickPrompts[b.dataset.quick]);if(b.id==='toggle-key'){const el=$('#api-key');el.type=el.type==='password'?'text':'password';b.textContent=el.type==='password'?'キーを表示':'キーを隠す';return;}if(b.id==='remove-key'){const next={model:settings.model||'gemini-3.5-flash-lite',key:''};if(write(KEYS.settings,next)){settings=next;$('#modal').close();render();toast('APIキーを削除しました。デモモードで使えます。');}return;}if(b.id==='clear-chat')return clearChatDialog();if(b.id==='confirm-clear-chat'){if(write(KEYS.chat,[])){chatEpoch++;controller?.abort();chat=[];$('#modal').close();renderChat();toast('相談履歴をクリアしました。');}}});
document.addEventListener('change',e=>{if(e.target.id==='role'){if(view==='submit')saveDraft(false);const next=e.target.value;if(!write(KEYS.role,next)){e.target.value=role;return;}role=next;editing=null;$('#modal').close();render();toast(role==='teacher'?'教員モードに切り替えました。':'学生モードに切り替えました。');}if(e.target.dataset.filter){filters[e.target.dataset.filter]=e.target.value;renderResults();}if(e.target.id==='sort'){filters.sort=e.target.value;renderResults();}});
document.addEventListener('input',e=>{if(e.target.id==='f-q'){filters.q=e.target.value;renderResults();}if(e.target.closest('#report-form'))saveDraft(false);});
document.addEventListener('submit',e=>{if(e.target.id==='report-form')return submitReport(e);if(e.target.id==='stage-form')return submitStage(e);if(e.target.id==='chat-form'){e.preventDefault();sendChat($('#chat-text').value);}if(e.target.id==='return-form'){e.preventDefault();const reason=$('#return-reason').value.trim();if(!reason){toast('差戻し理由を入力してください。');return;}updateReport(e.target.dataset.id,'returned',reason);}if(e.target.id==='key-form'){e.preventDefault();const key=$('#api-key').value.trim(),model=$('#api-model').value.trim();if(!/^[A-Za-z0-9._-]+$/.test(model)||key&&!/^[A-Za-z0-9_-]+$/.test(key)){toast('APIキー・モデル名の形式を確認してください。');return;}const next={key,model};if(write(KEYS.settings,next)){settings=next;$('#modal').close();render();toast(key?'API設定を保存しました。相談送信時に接続します。':'設定を保存しました。デモモードで使えます。');}}});
document.addEventListener('keydown',e=>{if(e.target.id==='chat-text'&&e.key==='Enter'&&(e.ctrlKey||e.metaKey)&&!e.isComposing){e.preventDefault();sendChat(e.target.value);}});
$('#modal').addEventListener('click',e=>{if(e.target===$('#modal')){const rect=$('#modal').getBoundingClientRect();if(e.clientX<rect.left||e.clientX>rect.right||e.clientY<rect.top||e.clientY>rect.bottom)$('#modal').close();}});
window.addEventListener('storage',e=>{if(e.key===KEYS.reports){const incoming=read(KEYS.reports,reports);if(validReports(incoming)){reports=incoming;if($('#modal').open)$('#modal').close();if(view==='submit'){nav();toast('提出ステータスが更新されました。画面を開き直すと確認できます。');}else if(view==='search'){nav();renderResults();const m=$('.metrics');if(m)m.outerHTML=metrics();}else render();}}if(e.key===KEYS.bookmarks){const next=read(KEYS.bookmarks,[]);bookmarks=Array.isArray(next)?next:[];if(view==='search'){renderResults();const m=$('.metrics');if(m)m.outerHTML=metrics();}}if(e.key===KEYS.settings){settings=read(KEYS.settings,{});if(!settings||typeof settings!=='object')settings={};if(view==='ai')render();else nav();}});
window.addEventListener('hashchange',()=>{const next=location.hash.slice(1);if(['search','submit','admin','dashboard','ai'].includes(next)&&view!==next){if(view==='submit')saveDraft(false);view=next;render();}});
view=['search','submit','ai','admin','dashboard'].includes(location.hash.slice(1))?location.hash.slice(1):'search';render();
