y\u003e=0.25.0 in /usr/local/lib/python3.13/dist-packages (from jsonschema\u003e=3.0-\u003ealtair!=5.4.0,!=5.4.1,\u003c7,\u003e=5.0.0-\u003estreamlit) (2026.9.1)\n","Requirement already satisfied: six\u003e=1.5 in /usr/local/lib/python3.13/dist-packages (from python-dateutil\u003e=2.8.2-\u003epandas) (1.17.0)\n"]}],"source":["!pip install streamlit scikit-learn pandas numpy"]},{"cell_type":"code","execution_count":1,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":14,"status":"ok","timestamp":1795065066257,"user":{"displayName":"大辻拓人","userId":"07846188453690175667"},"user_tz":-540},"id":"v8y2oiNP0wKI","outputId":"6ac965da-f503-403e-89c2-abe2fae5a09d"},"outputs":[{"name":"stdout","output_type":"stream","text":["Overwriting app.py\n"]}],"source":["%%writefile app.py\n","import streamlit as st\n","import pandas as pd\n","import numpy as np\n","from sklearn.linear_model import LinearRegression\n","\n","st.set_page_config(page_title=\"スマートフィットネス予測\", page_icon=\"⌚\", layout=\"wide\")\n","\n","@st.cache_resource\n","def train_model():\n","    # 少し本格的なダミーデータを300件生成（年齢、性別、体重、心拍数、運動時間）\n","    np.random.seed(42)\n","    n = 300\n","    age = np.random.randint(20, 60, n)\n","    gender = np.random.randint(0, 2, n) # 0: 女性, 1: 男性\n","    weight = np.random.uniform(50, 100, n)\n","    heart_rate = np.random.randint(100, 180, n)\n","    duration = np.random.randint(10, 120, n)\n","\n","    # 回帰分析用の目的変数（消費カロリー）を計算（※架空の計算式にノイズを追加）\n","    calories = (age * 0.5) + (gender * 40) + (weight * 1.5) + (heart_rate * 2.5) + (duration * 6.0) - 200\n","    calories += np.random.normal(0, 30, n) # ばらつき（ノイズ）を追加\n","\n","    df = pd.DataFrame({'age': age, 'gender': gender, 'weight': weight, 'heart_rate': heart_rate, 'duration': duration, 'calories': calories})\n","\n","    X = df[['age', 'gender', 'weight', 'heart_rate', 'duration']]\n","    y = df['calories']\n","\n","    # 線形回帰モデルの学習\n","    model = LinearRegression()\n","    model.fit(X, y)\n","    return model\n","\n","model = train_model()\n","\n","st.title(\"⌚ スマートウォッチ風 消費カロリー予測AI\")\n","st.markdown(\"年齢や平均心拍数などのデータを組み合わせて、多重回帰分析でパーソナライズされたカロリー予測を行います。\")\n","\n","# 入力フォームを左右のカラムで整理\n","col1, col2 = st.columns(2)\n","\n","with col1:\n","    st.subheader(\"👤 あなたのプロフィール\")\n","    age = st.number_input(\"年齢\", min_value=10, max_value=100, value=30)\n","    gender_str = st.radio(\"性別\", [\"女性\", \"男性\"], horizontal=True)\n","    gender = 1 if gender_str == \"男性\" else 0\n","    weight = st.number_input(\"体重 (kg)\", min_value=30.0, max_value=150.0, value=60.0, step=0.5)\n","\n","with col2:\n","    st.subheader(\"🏃‍♂️ 運動のデータ\")\n","    heart_rate = st.slider(\"平均心拍数 (bpm)\", min_value=80, max_value=200, value=130)\n","    duration = st.slider(\"運動時間 (分)\", min_value=5, max_value=180, value=45)\n","\n","st.write(\"---\")\n","\n","if st.button(\"AIでカロリーを計算する\", type=\"primary\", use_container_width=True):\n","    # 予測の実行\n","    input_df = pd.DataFrame([[age, gender, weight, heart_rate, duration]],\n","                            columns=['age', 'gender', 'weight', 'heart_rate', 'duration'])\n","    pred_cal = model.predict(input_df)[0]\n","    pred_cal = max(0, pred_cal) # マイナスになるのを防止\n","\n","    st.success(\"計算が完了しました！\")\n","\n","    # 結果表示エリア（左に数値、右にグラフ）\n","    res_col1, res_col2 = st.columns([1, 2])\n","\n","    with res_col1:\n","        st.metric(label=\"🔥 予測消費カロリー\", value=f\"{pred_cal:.0f} kcal\", delta=\"回帰分析による算出\")\n","\n","    # 追加機能：運動時間ごとの消費カロリー推移シミュレーショングラフ\n","    with res_col2:\n","        st.markdown(\"##### 📈 運動時間と消費カロリーのシミュレーション\")\n","        durations = range(10, 121, 10) # 10分〜120分まで10分刻み\n","        sim_data = []\n","        for d in durations:\n","            sim_df = pd.DataFrame([[age, gender, weight, heart_rate, d]],\n","                                  columns=['age', 'gender', 'weight', 'heart_rate', 'duration'])\n","            sim_cal = max(0, model.predict(sim_df)[0])\n","            sim_data.append({\"時間 (分)\": d, \"カロリー (kcal)\": sim_cal})\n","\n","        # グラフの描画\n","        st.line_chart(pd.DataFrame(sim_data).set_index(\"時間 (分)\"))"]},{"cell_type":"code","execution_count":3,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":99,"status":"ok","timestamp":1795065163238,"user":{"displayName":"大辻拓人","userId":"07846188453690175667"},"user_tz":-540},"id":"DuLXTtPB0-6u","outputId":"eb4663c4-10ba-49db-8233-0943608a170f"},"outputs":[{"name":"stdout","output_type":"stream","text":["8.235.48.33\n"]}],"source":["!wget -q -O - ipv4.icanhazip.com"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"background_save":true,"base_uri":"https://localhost:8080/"},"id":"wDUbjrx66l72"},"outputs":[{"name":"stdout","output_type":"stream","text":["\u001b[90m2026-11-19T05:13:20Z\u001b[0m \u001b[32mINF\u001b[0m Thank you for trying Cloudflare Tunnel. Doing so, without a Cloudflare account, is a quick way to experiment and try it out. However, be aware that these account-less Tunnels have no uptime guarantee, are subject to the Cloudflare Online Services Terms of Use (https://www.cloudflare.com/website-terms/), and Cloudflare reserves the right to investigate your use of Tunnels for violations of such terms. If you intend to use Tunnels in production you should use a pre-created named tunnel by following: https://developers.cloudflare.com/cloudflare-one/connections/connect-apps\n","\u001b[90m2026-11-19T05:13:20Z\u001b[0m \u001b[32mINF\u001b[0m Requesting new quick Tunnel on trycloudflare.com...\n","\n","Collecting usage statistics. To deactivate, set browser.gatherUsageStats to false.\n","\u001b[0m\n","2026-11-19 05:13:21.935 Uvicorn server started on :::8501\n","\u001b[0m\n","\u001b[34m\u001b[1m  You can now view your Streamlit app in your browser.\u001b[0m\n","\u001b[0m\n","\u001b[34m  Local URL: \u001b[0m\u001b[1mhttp://localhost:8501\u001b[0m\n","\u001b[34m  Network URL: \u001b[0m\u001b[1mhttp://172.28.0.12:8501\u001b[0m\n","\u001b[34m  External URL: \u001b[0m\u